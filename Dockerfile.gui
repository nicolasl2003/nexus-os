# Environnement de build de la pile graphique de Nexus OS (Wayland, bureau).
# Alpine Linux est nativement basée sur musl : compilateur C ET C++
# (harfbuzz, utilisé pour le rendu du texte, est en C++), même musl 1.2.5
# que le reste de Nexus OS. Tout est compilé depuis les sources, en statique.
FROM alpine:3.21

RUN apk add --no-cache \
        build-base linux-headers musl-libintl \
        meson ninja-build pkgconf cmake \
        python3 py3-packaging perl gperf bison flex \
        wget xz bzip2 tar coreutils zlib-dev libpng-dev \
        hwdata-dev hwdata-pnp

WORKDIR /work
