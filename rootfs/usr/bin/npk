#!/bin/sh
# npk — le gestionnaire de paquets de Nexus OS
#
# Un dépôt est un simple dossier HTTP contenant :
#   INDEX            une ligne par paquet : nom|version|dépendances|sha256|fichier|description
#   <nom>-<ver>.npk  archive tar.gz avec PKGINFO + files/ (arborescence relative à /usr/local)
#   INDEX.minisig    signature minisign de l'INDEX
#
# Chaîne de confiance : l'INDEX est signé (clés de confiance dans
# /etc/npk/keys/*.pub) et contient le SHA-256 de chaque paquet, vérifié au
# téléchargement. Un paquet modifié ou un index falsifié est donc refusé.
#
# Les paquets s'installent dans $NPK_ROOT (/usr/local), qui est sur le
# disque persistant quand il existe.

NPK_ROOT="${NPK_ROOT:-/usr/local}"
DB="$NPK_ROOT/var/lib/npk"
CACHE="$NPK_ROOT/var/cache/npk"
INDEX="$DB/INDEX"

REPO_URL="http://10.0.2.2:8080"
[ -f /etc/npk/repo.conf ] && . /etc/npk/repo.conf
[ -f "$NPK_ROOT/etc/npk/repo.conf" ] && . "$NPK_ROOT/etc/npk/repo.conf"

die() { printf '\033[1;31mnpk :\033[0m %s\n' "$*" >&2; exit 1; }
say() { printf '\033[1;36m::\033[0m %s\n' "$*"; }

# ---------- Outils internes ----------

# Téléchargement : curl (HTTPS, certificats vérifiés) s'il est installé,
# sinon wget de BusyBox (HTTP seulement : il ne vérifie pas les certificats).
download() {
    if [ -x "$NPK_ROOT/bin/curl" ]; then
        "$NPK_ROOT/bin/curl" -fsSL --retry 2 -o "$2" "$1"
    else
        case "$1" in
            https://*) die "dépôt HTTPS : installe d'abord curl (npk install curl, depuis un dépôt HTTP)" ;;
        esac
        wget -q -O "$2" "$1" 2>/dev/null
    fi
}

# Les commandes qui modifient le système demandent les droits root
need_root() {
    if [ "$(id -u)" != 0 ]; then
        die "cette commande doit être lancée en root : su -c 'npk $*'"
    fi
    mkdir -p "$DB/installed" "$CACHE" || die "impossible d'écrire dans $NPK_ROOT"
}

need_index()   { [ -f "$INDEX" ] || die "index absent : lance d'abord 'npk update'"; }
idx_line()     { grep "^$1|" "$INDEX" | head -n 1; }
field()        { echo "$1" | cut -d'|' -f"$2"; }
is_installed() { [ -f "$DB/installed/$1/PKGINFO" ]; }
pkginfo()      { sed -n "s/^$2=//p" "$DB/installed/$1/PKGINFO"; }

# Résolution des dépendances (parcours en profondeur) -> $ORDER
resolve() {
    case " $ORDER " in *" $1 "*) return ;; esac
    case " $VISITING " in *" $1 "*) die "dépendance circulaire sur $1" ;; esac
    _line=$(idx_line "$1")
    [ -n "$_line" ] || die "paquet introuvable : $1 (essaie 'npk search')"
    VISITING="$VISITING $1"
    for _dep in $(field "$_line" 3); do
        resolve "$_dep"
    done
    ORDER="$ORDER $1"
}

remove_files() {
    _list="$DB/installed/$1/files"
    [ -f "$_list" ] || return 0
    while IFS= read -r _f; do
        rm -f "$NPK_ROOT/$_f"
    done < "$_list"
    # Supprime les dossiers devenus vides, du plus profond au moins profond
    while IFS= read -r _f; do dirname "$_f"; done < "$_list" | sort -ru |
        while IFS= read -r _d; do
            [ "$_d" = "." ] || rmdir -p "$NPK_ROOT/$_d" 2>/dev/null
        done
    return 0
}

install_one() {
    _line=$(idx_line "$1")
    _ver=$(field "$_line" 2)
    _sum=$(field "$_line" 4)
    _file=$(field "$_line" 5)

    if is_installed "$1" && [ "$(pkginfo "$1" VERSION)" = "$_ver" ]; then
        echo "   $1 $_ver est déjà installé"
        return 0
    fi

    say "Téléchargement de $_file"
    download "$REPO_URL/$_file" "$CACHE/$_file" || die "échec du téléchargement de $_file"
    echo "$_sum  $CACHE/$_file" | sha256sum -c -s ||
        { rm -f "$CACHE/$_file"; die "somme de contrôle invalide pour $_file"; }

    _tmp=$(mktemp -d)
    tar -xzf "$CACHE/$_file" -C "$_tmp" || die "archive corrompue : $_file"
    (cd "$_tmp/files" && find . ! -type d | sed 's|^\./||' | sort) > "$_tmp/files.list"

    # Conflits : un fichier qui appartient déjà à un autre paquet.
    # Un seul grep par paquet installé (et non un par fichier : un paquet
    # peut contenir des centaines de fichiers).
    for _owner in "$DB"/installed/*/files; do
        [ -f "$_owner" ] || continue
        _o=$(basename "$(dirname "$_owner")")
        [ "$_o" = "$1" ] && continue
        _c=$(grep -xFf "$_owner" "$_tmp/files.list" | head -n 1)
        [ -z "$_c" ] || { rm -rf "$_tmp"; die "conflit : $_c appartient déjà à $_o"; }
    done

    # Mise à jour : on arrête les services actifs du paquet, puis on retire
    # les fichiers de l'ancienne version
    _restart=""
    if is_installed "$1"; then
        for _s in $(grep '^etc/init.d/S' "$DB/installed/$1/files"); do
            if "$NPK_ROOT/$_s" status >/dev/null 2>&1; then
                "$NPK_ROOT/$_s" stop
                _restart="$_restart $_s"
            fi
        done
        remove_files "$1"
    fi

    cp -a "$_tmp/files/." "$NPK_ROOT/"
    for _s in $_restart; do
        [ -x "$NPK_ROOT/$_s" ] && "$NPK_ROOT/$_s" start
    done
    mkdir -p "$DB/installed/$1"
    cp "$_tmp/PKGINFO" "$DB/installed/$1/PKGINFO"
    cp "$_tmp/files.list" "$DB/installed/$1/files"
    rm -rf "$_tmp"
    say "$1 $_ver installé"

    # Nouveau service fourni par le paquet ? On le signale.
    [ -n "$_restart" ] && return 0
    for _s in $(grep '^etc/init.d/S' "$DB/installed/$1/files"); do
        _sn=$(basename "$_s" | sed 's/^S[0-9][0-9]//')
        echo "   Service '$_sn' installé : démarre-le avec 'service $_sn start'"
        echo "   (il démarrera ensuite automatiquement à chaque boot)"
    done
}

# ---------- Commandes ----------

# Vérifie la signature de $INDEX.new avec les clés de confiance.
# Affiche l'horodatage signé (commentaire de confiance) en cas de succès.
verify_index() {
    for _key in /etc/npk/keys/*.pub "$NPK_ROOT"/etc/npk/keys/*.pub; do
        [ -f "$_key" ] || continue
        _out=$(minisign -V -p "$_key" -m "$INDEX.new" -x "$INDEX.minisig.new" 2>/dev/null) || continue
        _ts=$(echo "$_out" | sed -n 's/^Trusted comment: nexus-index timestamp:\([0-9][0-9]*\)$/\1/p')
        [ -n "$_ts" ] || continue
        echo "$_ts"
        return 0
    done
    return 1
}

cmd_update() {
    say "Mise à jour de l'index depuis $REPO_URL"
    rm -f "$INDEX.new" "$INDEX.minisig.new"
    download "$REPO_URL/INDEX" "$INDEX.new" ||
        { rm -f "$INDEX.new"; die "dépôt injoignable ($REPO_URL)"; }

    if ! download "$REPO_URL/INDEX.minisig" "$INDEX.minisig.new"; then
        rm -f "$INDEX.minisig.new"
        if [ "${ALLOW_UNSIGNED:-no}" = yes ]; then
            printf '\033[1;33m:: ATTENTION : dépôt non signé, paquets NON vérifiés (ALLOW_UNSIGNED=yes)\033[0m\n'
            mv "$INDEX.new" "$INDEX"
            say "$(wc -l < "$INDEX") paquet(s) disponible(s)"
            return 0
        fi
        rm -f "$INDEX.new"
        die "le dépôt n'est pas signé (INDEX.minisig absent) : mise à jour refusée"
    fi

    # 1. Authenticité : l'index doit être signé par une clé de confiance
    if ! _ts=$(verify_index); then
        rm -f "$INDEX.new" "$INDEX.minisig.new"
        die "SIGNATURE INVALIDE : l'index a été modifié ou ne vient pas d'une source de confiance. Mise à jour refusée, rien n'a changé."
    fi

    # 2. Fraîcheur : refuser un index plus ancien que celui déjà accepté
    #    (sinon un attaquant pourrait resservir un vieil index signé, avec
    #    d'anciens paquets vulnérables : "attaque par retour en arrière")
    _old=$(cat "$DB/INDEX.timestamp" 2>/dev/null || echo 0)
    if [ "$_ts" -lt "$_old" ]; then
        rm -f "$INDEX.new" "$INDEX.minisig.new"
        die "index signé le $(date -d "@$_ts" '+%F %T') plus ancien que l'actuel ($(date -d "@$_old" '+%F %T')) : possible attaque par retour en arrière, refusé."
    fi

    mv "$INDEX.new" "$INDEX"
    mv "$INDEX.minisig.new" "$INDEX.minisig"
    echo "$_ts" > "$DB/INDEX.timestamp"
    say "Signature vérifiée (index signé le $(date -d "@$_ts" '+%F %T'))"
    say "$(wc -l < "$INDEX") paquet(s) disponible(s)"
}

cmd_search() {
    need_index
    grep -i -- "${1:-}" "$INDEX" | while IFS='|' read -r n v _ _ _ d; do
        _tag=""
        is_installed "$n" && _tag=" \033[1;32m[installé]\033[0m"
        printf "\033[1m%s\033[0m %s%b\n    %s\n" "$n" "$v" "$_tag" "$d"
    done
}

cmd_list() {
    _n=0
    for _p in "$DB"/installed/*/PKGINFO; do
        [ -f "$_p" ] || continue
        _name=$(basename "$(dirname "$_p")")
        printf "%-20s %s\n" "$_name" "$(pkginfo "$_name" VERSION)"
        _n=$((_n + 1))
    done
    [ "$_n" -gt 0 ] || echo "Aucun paquet installé."
}

cmd_info() {
    [ -n "${1:-}" ] || die "usage : npk info <paquet>"
    if is_installed "$1"; then
        cat "$DB/installed/$1/PKGINFO"
        echo "STATUT=installé ($(wc -l < "$DB/installed/$1/files") fichiers)"
    else
        need_index
        _line=$(idx_line "$1"); [ -n "$_line" ] || die "paquet introuvable : $1"
        echo "NAME=$1"; echo "VERSION=$(field "$_line" 2)"
        echo "DEPENDS=$(field "$_line" 3)"; echo "DESC=$(field "$_line" 6)"
        echo "STATUT=non installé"
    fi
}

cmd_install() {
    [ $# -gt 0 ] || die "usage : npk install <paquet>..."
    need_index
    ORDER=""; VISITING=""
    for _p in "$@"; do resolve "$_p"; done
    say "Paquets à traiter :$ORDER"
    for _p in $ORDER; do install_one "$_p"; done
}

cmd_remove() {
    [ $# -gt 0 ] || die "usage : npk remove <paquet>..."
    for _p in "$@"; do
        is_installed "$_p" || die "$_p n'est pas installé"
        for _other in "$DB"/installed/*/PKGINFO; do
            [ -f "$_other" ] || continue
            _o=$(basename "$(dirname "$_other")")
            case " $* " in *" $_o "*) continue ;; esac
            case " $(pkginfo "$_o" DEPENDS) " in
                *" $_p "*) die "$_p est requis par $_o (supprime $_o d'abord)" ;;
            esac
        done
    done
    for _p in "$@"; do
        # Arrête les services du paquet avant de supprimer ses fichiers
        for _s in $(grep '^etc/init.d/S' "$DB/installed/$_p/files"); do
            [ -x "$NPK_ROOT/$_s" ] && "$NPK_ROOT/$_s" stop
        done
        remove_files "$_p"
        rm -rf "$DB/installed/$_p"
        say "$_p supprimé"
    done
}

# Paquets installés dont le dépôt propose une autre version (un nom par ligne)
outdated() {
    for _p in "$DB"/installed/*/PKGINFO; do
        [ -f "$_p" ] || continue
        _name=$(basename "$(dirname "$_p")")
        _line=$(idx_line "$_name"); [ -n "$_line" ] || continue
        [ "$(field "$_line" 2)" = "$(pkginfo "$_name" VERSION)" ] || echo "$_name"
    done
}

cmd_outdated() {
    [ -f "$INDEX" ] || exit 0
    outdated
}

cmd_upgrade() {
    need_index
    _todo=$(outdated | tr '\n' ' ')
    [ -n "${_todo% }" ] || { say "Tout est à jour."; return 0; }
    cmd_install $_todo
}

cmd_files() {
    is_installed "${1:-}" || die "usage : npk files <paquet installé>"
    sed "s|^|$NPK_ROOT/|" "$DB/installed/$1/files"
}

usage() {
    cat <<EOF
npk — gestionnaire de paquets de Nexus OS

  npk update              récupère la liste des paquets du dépôt
  npk search [mot]        cherche un paquet
  npk install <paquet>... installe (avec ses dépendances)
  npk remove <paquet>...  désinstalle
  npk upgrade             met à jour les paquets installés
  npk outdated            liste les paquets qui ont une mise à jour
  npk list                liste les paquets installés
  npk info <paquet>       détails d'un paquet
  npk files <paquet>      fichiers installés par un paquet

  npk alpine ...          logiciels d'Alpine Linux (~30 000) : update, search,
                          install, remove, list, upgrade (paquet « alpine »)

Dépôt : $REPO_URL   Racine : $NPK_ROOT
EOF
}

cmd="${1:-help}"; [ $# -gt 0 ] && shift
case "$cmd" in
    update)        need_root update;            cmd_update ;;
    search|s)      cmd_search "$@" ;;
    install|i|add) need_root install "$@";      cmd_install "$@" ;;
    remove|rm|del) need_root remove "$@";       cmd_remove "$@" ;;
    upgrade|up)    need_root upgrade;           cmd_upgrade ;;
    outdated)      cmd_outdated ;;
    list|ls)       cmd_list ;;
    info)          cmd_info "$@" ;;
    files)         cmd_files "$@" ;;
    alpine|a)
        [ -x /usr/local/bin/npk-alpine ] || die "installe d'abord le paquet alpine : npk install alpine"
        exec /usr/local/bin/npk-alpine "$@" ;;
    help|-h|--help) usage ;;
    *) usage; exit 1 ;;
esac
