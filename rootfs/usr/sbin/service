#!/bin/sh
# service — gère les services de Nexus OS
#
# Un service est un script /usr/local/etc/init.d/SNNnom (NN = ordre de
# démarrage) qui accepte start | stop | status. Ils sont installés par les
# paquets npk et lancés automatiquement au démarrage, sauf s'ils sont
# désactivés (fichier dans /usr/local/etc/service-disabled/).

INITD=/usr/local/etc/init.d
DISABLED=/usr/local/etc/service-disabled

die() { printf '\033[1;31mservice :\033[0m %s\n' "$*" >&2; exit 1; }

script_of() {
    for s in "$INITD"/S[0-9][0-9]"$1"; do
        [ -x "$s" ] && { echo "$s"; return 0; }
    done
    return 1
}
name_of() { basename "$1" | sed 's/^S[0-9][0-9]//'; }
is_enabled() { [ ! -f "$DISABLED/$1" ]; }

need_root() { [ "$(id -u)" = 0 ] || die "lance cette commande en root : su -c 'service $*'"; }

cmd_list() {
    found=0
    for s in "$INITD"/S[0-9][0-9]*; do
        [ -x "$s" ] || continue
        found=1
        n=$(name_of "$s")
        if "$s" status >/dev/null 2>&1; then st="\033[1;32mactif\033[0m  "; else st="\033[1;31marrêté\033[0m "; fi
        if is_enabled "$n"; then en="auto au démarrage"; else en="désactivé"; fi
        printf "%-14s %b %s\n" "$n" "$st" "$en"
    done
    [ "$found" = 1 ] || echo "Aucun service installé (ex. : npk install dropbear)."
}

# Appelé par rcS / rcK
boot_start() {
    for s in "$INITD"/S[0-9][0-9]*; do
        [ -x "$s" ] || continue
        is_enabled "$(name_of "$s")" && "$s" start
    done
}
boot_stop() {
    for s in $(ls -r "$INITD"/S[0-9][0-9]* 2>/dev/null); do
        [ -x "$s" ] && "$s" stop
    done
}

case "${1:-list}" in
    list|ls)       cmd_list ;;
    --boot-start)  boot_start ;;
    --boot-stop)   boot_stop ;;
    -h|--help|help)
        cat <<EOF
Usage : service                         liste les services
        service <nom> start|stop|restart|status
        service <nom> enable|disable    démarrage automatique ou non
EOF
        ;;
    *)
        name="$1"; action="${2:-status}"
        s=$(script_of "$name") || die "service inconnu : $name (voir : service list)"
        case "$action" in
            start|stop)  need_root "$name" "$action"; "$s" "$action" ;;
            restart)     need_root "$name" restart; "$s" stop; sleep 1; "$s" start ;;
            status)      "$s" status ;;
            enable)      need_root "$name" enable; rm -f "$DISABLED/$name"; echo "$name démarrera automatiquement." ;;
            disable)     need_root "$name" disable; mkdir -p "$DISABLED"; touch "$DISABLED/$name"; echo "$name ne démarrera plus automatiquement." ;;
            *)           die "action inconnue : $action" ;;
        esac
        ;;
esac
