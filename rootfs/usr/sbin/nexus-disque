#!/bin/sh
# nexus-disque — monte le disque persistant NEXUS_DATA sur /data (appelé par rcS)
#
#   nexus-disque monter     trouve le disque, le déverrouille s'il est chiffré
#                           (phrase secrète demandée sur l'écran et la console
#                           série), ou le chiffre si c'est demandé
#   nexus-disque etat       non-chiffre | demande | chiffre
#
# Chiffrement (désactivé par défaut) : Paramètres → Protection enregistre la
# phrase secrète dans /data/etc/.chiffrement-cle (lisible par root seulement).
# Au démarrage suivant, avant que /data serve, le disque est chiffré « sur
# place » en LUKS2 (AES-XTS, cryptsetup reencrypt) : le système de fichiers
# est rétréci de 32 Mo pour faire de la place à l'en-tête, puis chaque bloc est
# réécrit chiffré. Le fichier de la phrase, réécrit lui aussi, est ensuite
# supprimé. Ensuite, la phrase est demandée à chaque démarrage.
# Le disque chiffré garde l'étiquette NEXUS_DATA (étiquette LUKS2) et la
# disposition du clavier (champ « subsystem ») pour taper la phrase.

export DM_DISABLE_UDEV=1          # pas d'udev : cryptsetup crée /dev/mapper/* lui-même
CS=/usr/sbin/cryptsetup
MAP=nexus-data
KEY=/data/etc/.chiffrement-cle
LOG=/var/log/nexus-disque.log
mkdir -p /run/cryptsetup /data /var/log

# Consoles où l'on écrit/demande : l'écran (tty1) et la console série
consoles() {
    for c in $(cat /sys/class/tty/console/active 2>/dev/null); do
        case "$c" in
            tty0|tty) echo /dev/tty1 ;;
            *) [ -c "/dev/$c" ] && echo "/dev/$c" ;;
        esac
    done | sort -u
}
say() { for c in $(consoles); do printf "$@" > "$c" 2>/dev/null; done; }

# Disque chiffré LUKS étiqueté NEXUS_DATA
find_luks() {
    for d in /dev/vd[a-z] /dev/vd[a-z][0-9]* /dev/sd[a-z] /dev/sd[a-z][0-9]* \
             /dev/nvme[0-9]n[0-9]* /dev/mmcblk[0-9]*; do
        [ -b "$d" ] || continue
        "$CS" isLuks "$d" 2>/dev/null || continue
        "$CS" luksDump "$d" 2>/dev/null | grep -q '^Label:[[:space:]]*NEXUS_DATA' && { echo "$d"; return 0; }
    done
    return 1
}

keymap() {
    [ -n "$1" ] && [ -f "/usr/share/keymaps/$1.bmap.gz" ] && zcat "/usr/share/keymaps/$1.bmap.gz" | loadkmap 2>/dev/null
}

# Demande la phrase sur une console (5 essais), déverrouille le disque
ask_loop() {
    c=$1; dev=$2; i=0
    while [ $i -lt 5 ]; do
        [ -e "/dev/mapper/$MAP" ] && exit 0
        printf '\n\033[1;36mNexus OS\033[0m : le disque est chiffré.\nPhrase secrète du disque : ' > "$c"
        IFS= read -rs p < "$c" || exit 1
        echo > "$c"
        [ -e "/dev/mapper/$MAP" ] && exit 0
        printf 'Vérification...\n' > "$c"
        k="/run/nexus-cle.$$"
        ( umask 077; printf %s "$p" > "$k" )
        p=""
        if try_key "$dev" "$k" "$c"; then
            rm -f "$k"; printf '\033[1;32mDisque déverrouillé.\033[0m\n' > "$c"; exit 0
        fi
        rm -f "$k"
        [ -e "/dev/mapper/$MAP" ] && exit 0
        i=$((i + 1))
        printf '\033[1;31mPhrase incorrecte.\033[0m\n' > "$c"
    done
    exit 1
}

# Déverrouille avec la phrase du fichier $2. Si le chiffrement avait été
# interrompu (coupure de courant...), il est d'abord réparé puis terminé.
try_key() {
    dev=$1; k=$2; c=$3
    if "$CS" luksDump "$dev" 2>/dev/null | grep -q 'online-reencrypt'; then
        "$CS" repair --batch-mode --key-file "$k" "$dev" 2>>"$LOG" || return 1
        printf '\033[1;33mChiffrement interrompu : reprise (N'"'"'ÉTEINS PAS l'"'"'ordinateur)...\033[0m\n' > "$c"
        "$CS" reencrypt --resume-only --batch-mode --key-file "$k" --progress-frequency 10 "$dev" \
            > "$c" 2>>"$LOG" || return 1
        journal_later "CHIFFREMENT : chiffrement interrompu repris et terminé"
    fi
    "$CS" open --key-file "$k" "$dev" "$MAP" 2>>"$LOG"
}

# Le journal est sur le disque : on note dans /run, recopié une fois monté
journal_later() {
    ( umask 077; echo "$(date '+%Y-%m-%d %H:%M:%S') $*" >> /run/nexus-disque.journal )
}

unlock() {
    dev=$1
    keymap "$("$CS" luksDump "$dev" 2>/dev/null | sed -n 's/^Subsystem:[[:space:]]*//p')"
    pids=""
    for c in $(consoles); do
        ask_loop "$c" "$dev" &
        pids="$pids $!"
    done
    # Attendre : disque ouvert (sur une console), ou toutes les consoles ont abandonné
    while [ ! -e "/dev/mapper/$MAP" ]; do
        alive=0
        for p in $pids; do kill -0 "$p" 2>/dev/null && alive=1; done
        [ "$alive" = 1 ] || break
        sleep 1
    done
    for p in $pids; do kill "$p" 2>/dev/null; done
    wait 2>/dev/null
    for c in $(consoles); do stty echo icanon < "$c" 2>/dev/null; done   # saisie masquée interrompue
    [ -e "/dev/mapper/$MAP" ]
}

# Chiffrement sur place du disque $1 (non monté), phrase dans /run/nexus-cle
encrypt() {
    dev=$1; km=$2
    say '\n\033[1;33m*** Chiffrement du disque en cours : N'"'"'ÉTEINS PAS l'"'"'ordinateur ***\033[0m\n'
    say 'Cela peut prendre plusieurs minutes (selon la taille du disque).\n'
    e2fsck -f -y "$dev" >>"$LOG" 2>&1
    [ $? -lt 4 ] || { echo "e2fsck a échoué" >>"$LOG"; return 1; }
    sectors=$(cat "/sys/class/block/${dev##*/}/size")
    kb=$((sectors / 2 - 32768))
    resize2fs "$dev" "${kb}K" >>"$LOG" 2>&1 || { echo "resize2fs a échoué (disque trop plein ?)" >>"$LOG"; return 1; }
    "$CS" reencrypt --encrypt --type luks2 --reduce-device-size 32M --batch-mode \
        --key-file /run/nexus-cle --pbkdf argon2id --pbkdf-memory 262144 \
        --label NEXUS_DATA --subsystem "${km:-fr}" --progress-frequency 10 "$dev" \
        >"$(consoles | head -n 1)" 2>>"$LOG" || { echo "cryptsetup reencrypt a échoué" >>"$LOG"; return 2; }
    "$CS" open --key-file /run/nexus-cle "$dev" "$MAP" 2>>"$LOG"
}

journal() {
    mkdir -p /data/local/var/log
    ( umask 077
      [ -f /run/nexus-disque.journal ] && cat /run/nexus-disque.journal >> /data/local/var/log/securite.log
      rm -f /run/nexus-disque.journal
      echo "$(date '+%Y-%m-%d %H:%M:%S') $*" >> /data/local/var/log/securite.log )
}

monter() {
    rm -f /run/nexus-data.dev /run/nexus-data.src
    if dev=$(find_luks); then
        echo "$dev" > /run/nexus-data.dev
        if unlock "$dev" && mount -t ext4 "/dev/mapper/$MAP" /data; then
            echo "$dev (chiffré)" > /run/nexus-data.src
            rm -f "$KEY"            # (chiffrement interrompu puis repris : la demande est faite)
            journal "DISQUE : déverrouillé au démarrage"
            return 0
        fi
        say '\033[1;31mDisque non déverrouillé\033[0m : démarrage sans le disque (mode live, rien n'"'"'est sauvegardé).\n'
        sleep 3
        return 1
    fi
    dev=$(findfs LABEL=NEXUS_DATA 2>/dev/null) || return 1
    mount -t ext4 "$dev" /data || return 1
    echo "$dev" > /run/nexus-data.src
    [ -f "$KEY" ] || return 0

    # Chiffrement demandé dans Paramètres → Protection
    ( umask 077; cp "$KEY" /run/nexus-cle )
    km=$(cat /data/keyboard 2>/dev/null)
    umount /data || { rm -f /run/nexus-cle; return 0; }
    encrypt "$dev" "$km"
    rc=$?
    if [ $rc = 0 ] && mount -t ext4 "/dev/mapper/$MAP" /data; then
        rm -f "$KEY"
        echo "$dev" > /run/nexus-data.dev
        echo "$dev (chiffré)" > /run/nexus-data.src
        journal "CHIFFREMENT : le disque est maintenant chiffré (LUKS2)"
        say '\033[1;32mDisque chiffré.\033[0m La phrase secrète sera demandée à chaque démarrage.\n'
    elif [ $rc = 1 ]; then
        # Rien n'a été chiffré : on remonte le disque tel quel et on abandonne la demande
        mount -t ext4 "$dev" /data
        rm -f "$KEY"
        journal "CHIFFREMENT : échec avant de commencer (voir /var/log/nexus-disque.log), disque inchangé"
        say '\033[1;31mÉchec du chiffrement\033[0m : le disque n'"'"'a pas été modifié (détails : /var/log/nexus-disque.log).\n'
        sleep 5
    else
        say '\033[1;31mÉchec du chiffrement\033[0m (détails : /var/log/nexus-disque.log). Démarrage sans le disque.\n'
        sleep 10
    fi
    rm -f /run/nexus-cle
    mountpoint -q /data
}

case "${1:-}" in
    monter) monter ;;
    etat)
        if [ -e "/dev/mapper/$MAP" ]; then echo chiffre
        elif [ -f "$KEY" ]; then echo demande
        else echo non-chiffre; fi ;;
    *) echo "Usage : nexus-disque monter|etat" >&2; exit 2 ;;
esac
