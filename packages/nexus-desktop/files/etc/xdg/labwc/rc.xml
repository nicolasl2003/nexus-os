<?xml version="1.0"?>
<!-- Configuration du bureau Nexus (compositeur labwc) -->
<labwc_config>
  <core>
    <decoration>server</decoration>
    <gap>6</gap>
  </core>

  <theme>
    <name>Nexus</name>
    <cornerRadius>8</cornerRadius>
    <font place="ActiveWindow"><name>DejaVu Sans</name><size>10</size><weight>bold</weight></font>
    <font place="InactiveWindow"><name>DejaVu Sans</name><size>10</size></font>
    <font place="MenuItem"><name>DejaVu Sans</name><size>10</size></font>
    <font place="OnScreenDisplay"><name>DejaVu Sans</name><size>11</size></font>
  </theme>

  <placement><policy>cascade</policy></placement>

  <!-- Bureaux virtuels : 4 espaces de travail (Super+1…4, Ctrl+Alt+flèches) -->
  <desktops number="4">
    <prefix>Bureau</prefix>
    <popupTime>900</popupTime>
  </desktops>

  <!-- Alt+Tab : liste des fenêtres (leur titre) ; la
       fenêtre choisie est montrée en avant pendant le choix -->
  <windowSwitcher show="yes" preview="yes" outlines="yes" allWorkspaces="no">
    <fields>
      <field content="title" width="100%" />
    </fields>
  </windowSwitcher>

  <!-- Aimantation : glisser une fenêtre contre un bord ou dans un coin.
       Haut (centre) = plein écran ; gauche/droite = moitié d'écran ;
       coins = quart d'écran (régions nexus-*, gérées par notre labwc). -->
  <snapping>
    <range>12</range>
    <topMaximize>yes</topMaximize>
    <overlay><enabled>yes</enabled></overlay>
  </snapping>
  <regions>
    <region name="nexus-haut-gauche" x="0%" y="0%" width="50%" height="50%" />
    <region name="nexus-haut-droite" x="50%" y="0%" width="50%" height="50%" />
    <region name="nexus-bas-gauche" x="0%" y="50%" width="50%" height="50%" />
    <region name="nexus-bas-droite" x="50%" y="50%" width="50%" height="50%" />
  </regions>

  <!-- Redimensionner : tirer un bord ou un coin de la fenêtre,
       ou Alt + clic droit glissé n'importe où dans la fenêtre -->
  <resize><popupShow>Nonpixel</popupShow><drawContents>yes</drawContents></resize>

  <keyboard>
    <default />
    <!-- Super+Entrée ou Ctrl+Alt+T : ouvrir un terminal -->
    <keybind key="W-Return"><action name="Execute" command="foot" /></keybind>
    <keybind key="C-A-t"><action name="Execute" command="foot" /></keybind>
    <!-- Touche Super (Windows) : ouvrir/fermer le menu Démarrer -->
    <keybind key="Super_L" onRelease="yes"><action name="Execute" command="nexus-menu" /></keybind>
    <!-- Impr écran : capture de l'écran (enregistrée dans Images) -->
    <keybind key="Print"><action name="Execute" command="nexus-screenshot" /></keybind>
    <!-- Ctrl+Maj+Échap : moniteur système -->
    <keybind key="C-S-Escape"><action name="Execute" command="nexus-monitor" /></keybind>
    <!-- Fenêtres : Alt+Tab (défaut), Alt+Maj+Tab = en arrière, Super+Tab -->
    <keybind key="A-S-Tab"><action name="PreviousWindow" /></keybind>
    <keybind key="W-Tab"><action name="NextWindow" /></keybind>
    <!-- Bureaux virtuels -->
    <keybind key="C-A-Left"><action name="GoToDesktop" to="left" wrap="yes" /></keybind>
    <keybind key="C-A-Right"><action name="GoToDesktop" to="right" wrap="yes" /></keybind>
    <keybind key="C-A-S-Left"><action name="SendToDesktop" to="left" wrap="yes" /></keybind>
    <keybind key="C-A-S-Right"><action name="SendToDesktop" to="right" wrap="yes" /></keybind>
    <keybind key="W-1"><action name="GoToDesktop" to="1" /></keybind>
    <keybind key="W-2"><action name="GoToDesktop" to="2" /></keybind>
    <keybind key="W-3"><action name="GoToDesktop" to="3" /></keybind>
    <keybind key="W-4"><action name="GoToDesktop" to="4" /></keybind>
    <keybind key="W-S-1"><action name="SendToDesktop" to="1" /></keybind>
    <keybind key="W-S-2"><action name="SendToDesktop" to="2" /></keybind>
    <keybind key="W-S-3"><action name="SendToDesktop" to="3" /></keybind>
    <keybind key="W-S-4"><action name="SendToDesktop" to="4" /></keybind>
    <!-- Super+L : verrouiller l'écran -->
    <keybind key="W-l"><action name="Execute" command="nexus-lock" /></keybind>
    <!-- Alt+F4 : fermer la fenêtre -->
    <keybind key="A-F4"><action name="Close" /></keybind>
  </keyboard>

  <mouse>
    <default />
  </mouse>
</labwc_config>
