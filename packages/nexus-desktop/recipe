NAME=nexus-desktop
VERSION=0.10.0
DEPENDS="labwc foot alsa wifi"
DESC="Le bureau de Nexus OS : connexion graphique, barre des tâches, menu Démarrer, widgets, fichiers"

. "$PKG_LIB/gui.sh"

build() {
    # Session, thème, réglages (fichiers de la recette)
    cp -a "$RECIPE_DIR/files/." "$DESTDIR$PREFIX/"
    chmod 755 "$DESTDIR$PREFIX/bin/"*

    # Nos programmes (dossier desktop/, compilés par 'make desktop-apps')
    apps="$BUILD_DIR/gui/nexus-apps/bin"
    [ -x "$apps/nexus-shell" ] || { echo "Programmes du bureau absents : lance 'make desktop-apps'" >&2; exit 1; }
    install -m 755 "$apps/nexus-shell" "$DESTDIR$PREFIX/bin/nexus-shell"
    for prog in nexus-panel nexus-menu nexus-wallpaper nexus-settings nexus-files nexus-widgets nexus-greeter nexus-volume nexus-network nexus-store nexus-notifyd nexus-notify nexus-assistant; do
        ln -s nexus-shell "$DESTDIR$PREFIX/bin/$prog"
    done
    # Arrêt/redémarrage depuis le menu : setuid root, réservé au groupe video
    install -D -m 4755 "$apps/nexus-power" "$DESTDIR$PREFIX/libexec/nexus-power"
    # Magasin d'applications : installe/supprime via npk après vérification du
    # mot de passe administrateur (setuid root, actions et noms contrôlés)
    install -D -m 4755 "$apps/nexus-pkg" "$DESTDIR$PREFIX/libexec/nexus-pkg"
    # Paramètres → Comptes : ajouter, supprimer, changer de mot de passe
    install -D -m 4755 "$apps/nexus-account" "$DESTDIR$PREFIX/libexec/nexus-account"
    # Connexion graphique (lancée sur le premier écran par /usr/sbin/nexus-tty1)
    install -D -m 755 "$apps/nexus-login" "$DESTDIR$PREFIX/sbin/nexus-login"

    # Applications affichées dans le menu Démarrer
    mkdir -p "$DESTDIR$PREFIX/share/applications"
    cp "$ROOT_DIR"/desktop/data/applications/*.desktop "$DESTDIR$PREFIX/share/applications/"
}
