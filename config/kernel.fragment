# Options ajoutées par-dessus x86_64_defconfig
CONFIG_LOCALVERSION="-nexus"
CONFIG_DEFAULT_HOSTNAME="nexus"
CONFIG_BLK_DEV_INITRD=y
CONFIG_RD_GZIP=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_BLK=y

# --- Affichage graphique ---
# Pilotes d'écran : virtio-gpu (QEMU), bochs (QEMU -vga std), simpledrm
# (framebuffer fourni par le BIOS/UEFI : marche sur la plupart des vrais PC)
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y
CONFIG_DRM_BOCHS=y
CONFIG_DRM_SIMPLEDRM=y
CONFIG_SYSFB_SIMPLEFB=y
# VirtualBox : carte VMSVGA (défaut des VM Linux) et VBoxSVGA/VBoxVGA
CONFIG_DRM_VMWGFX=y
CONFIG_DRM_VBOXVIDEO=y
# Console texte sur l'écran graphique (fbcon)
CONFIG_FB=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_FRAMEBUFFER_CONSOLE=y
CONFIG_FRAMEBUFFER_CONSOLE_DETECT_PRIMARY=y
# Logo de démarrage (remplacé par celui de Nexus OS, voir config/logo/)
CONFIG_LOGO=y
CONFIG_LOGO_LINUX_CLUT224=y
# CONFIG_LOGO_LINUX_MONO is not set
# CONFIG_LOGO_LINUX_VGA16 is not set
# Clavier/souris (virtio dans QEMU) exposés via /dev/input/event* (evdev)
CONFIG_VIRTIO_INPUT=y
CONFIG_INPUT_EVDEV=y
# Décompresseur du noyau silencieux (sinon il écrit ses adresses à l'écran)
# CONFIG_X86_VERBOSE_BOOTUP is not set

# --- Son ---
# Codecs des cartes son courantes (puces Realtek, HDMI des cartes graphiques,
# Conexant, IDT) + cartes son USB. QEMU : intel-hda + codec générique.
CONFIG_SND_HDA_GENERIC=y
CONFIG_SND_HDA_CODEC_REALTEK=y
CONFIG_SND_HDA_CODEC_HDMI=y
CONFIG_SND_HDA_CODEC_CONEXANT=y
CONFIG_SND_HDA_CODEC_SIGMATEL=y
# Codec AD1984 de la carte son « Intel HD Audio » de VirtualBox
CONFIG_SND_HDA_CODEC_ANALOG=y
CONFIG_SND_USB_AUDIO=y

# --- Wi-Fi ---
# Pilotes en modules (chargés à la demande, livrés avec leurs firmwares dans
# le paquet linux-wifi) : Intel, MediaTek, Realtek, Atheros.
CONFIG_IWLWIFI=m
CONFIG_IWLMVM=m
CONFIG_IWLDVM=m
CONFIG_MT7921E=m
CONFIG_MT7921U=m
CONFIG_RTW88=m
CONFIG_RTW88_8822CE=m
CONFIG_RTW88_8821CE=m
CONFIG_RTW88_8822BE=m
CONFIG_ATH9K=m
CONFIG_ATH9K_HTC=m
# Radios Wi-Fi simulées, pour tester sans matériel
CONFIG_MAC80211_HWSIM=m

# Espaces de noms utilisateur : bac à sable (sandbox) de Firefox et autres navigateurs
CONFIG_USER_NS=y

# ---- Sécurité (Nexus 0.14) ----
# Pare-feu nftables (outil nft, paquet parefeu) : filtrage IPv4/IPv6 avec
# suivi des connexions (« laisser revenir les réponses à ce que j'ai demandé »)
CONFIG_NETFILTER_ADVANCED=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_TABLES=y
CONFIG_NF_TABLES_INET=y
CONFIG_NF_TABLES_IPV4=y
CONFIG_NF_TABLES_IPV6=y
CONFIG_NFT_CT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_REJECT_INET=y
CONFIG_NF_REJECT_IPV4=y
CONFIG_NF_REJECT_IPV6=y
CONFIG_NF_LOG_SYSLOG=y
# Yama : un programme ne peut plus espionner (ptrace) un autre programme
# qui n'est pas son enfant (protège les mots de passe tapés ailleurs)
CONFIG_SECURITY=y
CONFIG_SECURITY_YAMA=y
# Copies noyau <-> programmes vérifiées (bloque une famille de failles)
CONFIG_HARDENED_USERCOPY=y
# Pas d'accès direct à la mémoire physique ni à la mémoire du noyau
CONFIG_STRICT_DEVMEM=y
CONFIG_IO_STRICT_DEVMEM=y

# ---- Chiffrement du disque de données (Nexus 0.15, cryptsetup / LUKS2) ----
CONFIG_MD=y
CONFIG_BLK_DEV_DM=y
CONFIG_DM_CRYPT=y
CONFIG_CRYPTO_XTS=y
CONFIG_CRYPTO_AES=y
CONFIG_CRYPTO_AES_NI_INTEL=y
CONFIG_CRYPTO_SHA256=y
CONFIG_CRYPTO_SHA512=y
# interface crypto du noyau utilisée par cryptsetup (zones de clés LUKS)
CONFIG_CRYPTO_USER_API_HASH=y
CONFIG_CRYPTO_USER_API_SKCIPHER=y

# ---- Matériel branché à chaud (Nexus 0.15.1) ----
# Le noyau appelle /usr/sbin/nexus-hotplug (réglé par rcS dans
# /proc/sys/kernel/hotplug) à chaque branchement : pilote chargé à la volée
CONFIG_UEVENT_HELPER=y
CONFIG_UEVENT_HELPER_PATH=""
